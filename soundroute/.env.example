# Copy to .env. Never commit .env. Values below are LOCAL DEV ONLY.
POSTGRES_USER=soundroute
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=soundroute
DATABASE_URL=postgresql+psycopg://soundroute:change-me-local-only@db:5432/soundroute

# Where the browser fetches audio/artwork from.
# Local: served by the backend/nginx. AWS: the CloudFront domain.
MEDIA_BASE_URL=http://localhost:8000/media
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
APP_ENV=local
