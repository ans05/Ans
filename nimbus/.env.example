# Nimbus local configuration.
# Copy this file to apps/web/.env.local for the web app. Never commit .env.local.

# Which backend the web app talks to.
#   local  — in-browser mock data and localStorage; no AWS needed (default)
#   aws    — the deployed API Gateway + Lambda backend
NEXT_PUBLIC_NIMBUS_MODE=local

# aws mode only: base URL printed by the CDK deploy, e.g.
# https://abc123.execute-api.us-west-2.amazonaws.com/prod
NEXT_PUBLIC_API_BASE_URL=

# aws mode only: API Gateway key printed by the CDK deploy.
# It is a throttling key, not a secret, and ships in the static bundle.
NEXT_PUBLIC_API_KEY=
