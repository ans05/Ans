# ---- Web app -----------------------------------------------------------------
# mock  → everything runs in-process from packages/core/src/mock/sample-week.json
# aws   → the Next.js server talks to the API Gateway stack deployed by /infra
NIMBUS_MODE=mock

# Fixed "now" used in mock mode so the demo is stable. Set to "real" to use the clock.
NIMBUS_DEMO_NOW=2026-10-13T08:45:00-07:00

# aws mode only (filled in by `cdk deploy` outputs)
NIMBUS_API_BASE_URL=
NIMBUS_API_KEY=

# ---- Claude ------------------------------------------------------------------
# Deployed Lambdas call Claude through Amazon Bedrock using the Lambda's IAM role.
# Locally you can opt into the Anthropic API instead of the template-based mock:
NIMBUS_LLM=mock            # mock | anthropic | bedrock
ANTHROPIC_API_KEY=
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
