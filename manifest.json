{
  "manifest_version": 3,
  "name": "Spotlight Productivity",
  "description": "A Chrome extension for enhancing productivity with a Pomodoro timer, website blocker, and task manager.",
  "version": "1.1",
  "permissions": ["storage", "tabs", "alarms", "notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "images/spotlight.png"
  },
  "icons": {
    "16": "images/spotlight.png",
    "48": "images/spotlight.png",
    "128": "images/spotlight.png"
  }
}
