{
  "manifest_version": 3,
  "name": "Lock In",
  "description": "Lock in: start a focus session, block distracting sites until it ends, and knock out your tasks.",
  "version": "2.0",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "images/spotlight.png"
  },
  "icons": {
    "16": "images/spotlight.png",
    "48": "images/spotlight.png",
    "128": "images/spotlight.png"
  }
}
